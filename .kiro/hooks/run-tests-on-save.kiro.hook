{
  "enabled": true,
  "name": "Run tests on save",
  "description": "Run unit tests whenever a lib or server file is saved",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["lib/**/*.js", "server.js"] },
  "then": { "type": "askAgent", "prompt": "Run `npm test`. If anything fails, explain the failure and propose a minimal fix." }
}
